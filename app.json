{
  "expo": {
    "name": "Hinge Guess",
    "slug": "hinge-guess-angular-native",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.erkamyaman.hingeguess.native"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.github.erkamyaman.hingeguess.native"
    },
    "scheme": "hingeguess",
    "extra": {
      "router": {
        "root": "src/app"
      }
    },
    "plugins": [
      "@ng-native/metro"
    ]
  }
}
